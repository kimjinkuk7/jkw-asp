# --- 업로드 파일 ---------------------------------------------------------
# 폴더 구조는 남기고 내용물은 올리지 않는다.
# (앱이 월별 하위 폴더를 직접 만들지만, upload/board 자체가 없으면 첫 업로드가 실패한다)
upload/**
!upload/
!upload/*/
!upload/**/.gitkeep

# --- 로컬 전용 -----------------------------------------------------------
*.log
*.bak
*.user
.vs/
.vscode/
.idea/
Thumbs.db
desktop.ini

# --- 비밀값 --------------------------------------------------------------
# App.Conf.asp 의 PG 키 / CRYPT_KEY 는 플레이스홀더로 커밋한다.
# Classic ASP 는 조건부 include 를 못 하므로 "로컬 설정 파일" 분리가 불가능하다.
#   -> 로컬에서 실제 키를 채웠다면 커밋 전에 반드시 확인할 것.
#      git diff App.Conf.asp
*.secret
*.local.asp
