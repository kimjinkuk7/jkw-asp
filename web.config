<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
   jkw.com  :  Classic ASP 스택  (단독 리포지토리)
  ============================================================================
   대상 : IIS 10 / Classic ASP

   이 파일 하나로 이 폴더가 독립 사이트로 동작한다.
   상위 폴더의 web.config 에 의존하지 않는다.

   [배치]
     권장 : 이 폴더를 IIS 사이트의 물리 경로로 지정한다.
            그 경우 App.Conf.asp 의 APP_ROOT / VIEW_ROOT / UPLOAD_ROOT 를
            ""  /  "/view"  /  "/upload"  로 바꾼다.

     대안 : 사이트 루트 아래 asp 폴더로 둔다 (현재 개발 PC 가 이 형태).
            APP_ROOT / VIEW_ROOT / UPLOAD_ROOT = "/asp" / "/asp/view" / "/asp/upload"

   [★ 중요 — asp 섹션은 애플리케이션 루트에서만 적용된다]
     system.webServer/asp 는 IIS 애플리케이션 루트의 web.config 에서만 반영된다.
     하위 디렉터리에 두면 IIS 가 오류 없이 조용히 무시한다. (2026-11-24 실측)
       - 이 폴더가 사이트 루트  -> 아래 asp 섹션이 그대로 적용된다
       - 사이트 루트 아래 asp 폴더 -> 무시된다. 사이트 루트 web.config 에 같은 값을 넣어야 한다
     실측 근거 : enableParentPaths 미적용 시
       #include file="../x.asp"  -> 500 ,  Server.MapPath("..") -> ASP 0175

   [사전 작업] asp 구성 섹션은 IIS 기본이 잠금(Deny)이라 해제해야 한다.
     appcmd.exe unlock config -section:system.webServer/asp

   [운영 전환 시 반드시 변경]
     1) httpErrors errorMode = "Custom"
     2) asp scriptErrorSentToBrowser = "false"
     3) App.Conf.asp 의 DEBUG_MODE = False

   [주의] XML 주석 안에는 하이픈 2개를 연속으로 쓸 수 없다.
          구분선은 = 문자만 사용할 것.
  ============================================================================
-->
<configuration>

  <system.webServer>

    <!-- ====================================================================
         1. 기본 문서 :  /  ->  default.asp  ->  view/main/Default.asp
         ====================================================================
         value 는 대소문자 무시 고유값이다. default.asp 와 Default.asp 를
         함께 넣으면 중복으로 판정되어 HTTP 500.19 가 발생한다. -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="default.asp" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />


    <!-- ====================================================================
         2. Classic ASP 런타임
         ====================================================================
         enableParentPaths : ★ 필수. 모든 include 가 상대경로(#include file=)이고
                             ../ 로 상위를 거슬러 올라간다. false 면 전 페이지 500.
         maxRequestEntityAllowed : POST 본문 최대 크기 (기본 200KB 를 20MB 로)
                                   App.Conf.asp 의 UPLOAD_MAX_SIZE 와 일치시킬 것
         ==================================================================== -->
    <asp
        enableParentPaths="true"
        bufferingOn="true"
        scriptLanguage="VBScript"
        codePage="65001"
        lcid="1042"
        errorsToNTLog="true"
        scriptErrorSentToBrowser="true"
        appAllowClientDebug="false"
        appAllowDebugging="false">

      <limits maxRequestEntityAllowed="20971520"
              scriptTimeout="00:01:30"
              bufferingLimit="20971520" />

      <session allowSessionState="true"
               keepSessionIdSecure="true"
               timeout="02:00:00" />

      <cache diskTemplateCacheDirectory="%TEMP%"
             enableTypelibCache="true"
             scriptFileCacheSize="500"
             scriptEngineCacheMax="250" />
    </asp>


    <!-- ====================================================================
         3. 보안 : 소스 디렉터리 직접 접근 차단
         ====================================================================
         hiddenSegments 는 경로의 어느 위치에 있든 그 세그먼트를 막는다.
         서버 사이드 include 는 HTTP 요청이 아니므로 영향을 받지 않는다.
         ==================================================================== -->
    <security>
      <requestFiltering removeServerHeader="true">

        <hiddenSegments>
          <add segment="code" />
          <add segment="model" />
          <add segment="lib" />
          <add segment="conf" />
          <add segment="db" />
          <add segment="docs" />
          <add segment="tools" />
          <add segment="App.Conf.asp" />
          <add segment=".git" />
          <add segment=".github" />
        </hiddenSegments>

        <!-- 소스 / 백업 파일 노출 방지 -->
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".sql"    allowed="false" />
          <add fileExtension=".md"     allowed="false" />
          <add fileExtension=".bak"    allowed="false" />
          <add fileExtension=".config" allowed="false" />
          <add fileExtension=".log"    allowed="false" />
          <add fileExtension=".ps1"    allowed="false" />
          <add fileExtension=".gitignore" allowed="false" />
        </fileExtensions>

        <requestLimits maxAllowedContentLength="20971520" />

        <!-- 경로 조작 차단. 콜론은 넣지 말 것 (쿼리스트링까지 400 이 된다) -->
        <denyUrlSequences>
          <add sequence=".." />
        </denyUrlSequences>

      </requestFiltering>
    </security>


    <!-- ====================================================================
         4. 응답 헤더 (보안)
         ==================================================================== -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=()" />
      </customHeaders>
    </httpProtocol>


    <!-- ====================================================================
         5. 오류 페이지
         ==================================================================== -->
    <httpErrors errorMode="Detailed" existingResponse="Auto" />


    <!-- ====================================================================
         6. 정적 파일 MIME / 압축
         ==================================================================== -->
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

  </system.webServer>


  <!-- ======================================================================
       7. 업로드 폴더 : 실행 권한 제거
       ======================================================================
       업로드된 파일이 ASP 로 실행되는 것을 막는다.
       갤러리 / 포트폴리오 썸네일은 img 태그로 직접 표시하므로 이미지 확장자만
       정적 읽기를 허용하고, 그 외 첨부는 view/board/Download.asp 를 경유하게 한다.

       allowUnlisted="false" + 이미지 확장자 화이트리스트 만으로 .asp 요청이
       차단되므로 handlers accessPolicy 는 쓰지 않는다.
       (system.webServer/handlers 는 IIS 기본값이 잠김(Deny)이라 web.config 에
        두면 HTTP 500.19 가 발생한다)
       ====================================================================== -->
  <location path="upload">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      </staticContent>
      <security>
        <requestFiltering>
          <fileExtensions allowUnlisted="false">
            <add fileExtension=".jpg"  allowed="true" />
            <add fileExtension=".jpeg" allowed="true" />
            <add fileExtension=".gif"  allowed="true" />
            <add fileExtension=".png"  allowed="true" />
            <add fileExtension=".webp" allowed="true" />
          </fileExtensions>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>


  <!-- ======================================================================
       8. 정적 리소스 캐시
       ====================================================================== -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

</configuration>
